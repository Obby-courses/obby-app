{
  "expo": {
    "name": "Obby",
    "slug": "obby",
    "version": "1.2.0",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "76385f66-625f-4bec-b35b-53fae0b629e7"
      },
      "router": {
        "origin": false
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/76385f66-625f-4bec-b35b-53fae0b629e7",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "default",
    "android": {
      "package": "com.obby.app",
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.obby.app",
      "buildNumber": "1.2.0",
      "supportsTablet": true
    }
  }
}